# =====================================================================
#  CHRONYX - variables d'environnement (copier ce fichier en ".env")
#
#  AUCUN MOT DE PASSE ICI. Methode recommandee : ouvrir MetaTrader 5,
#  se connecter au compte (demo), et laisser ces lignes vides.
#
#  Option : pour une connexion automatique, renseigner login + serveur
#  et enregistrer le mot de passe dans le Gestionnaire d'identifiants
#  Windows avec :  python -m chronyx.secrets enregistrer VOTRE_LOGIN
# =====================================================================

# Chemin du terminal (utile si plusieurs MetaTrader 5 sont installes)
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# MT5_LOGIN=12345678
# MT5_SERVER=NomDuBroker-Demo

# Decalage horaire du serveur du broker par rapport a UTC (ex: 2 ou 3).
# Detecte automatiquement quand le marche est ouvert ; utile seulement le week-end.
# MT5_UTC_OFFSET_HEURES=2
